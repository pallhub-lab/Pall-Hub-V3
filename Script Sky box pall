gui.Name = "SkyVisualV7_Final_X"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- === DATA ORIGINAL ===
local original = {ClockTime = Lighting.ClockTime, Brightness = Lighting.Brightness, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, FogEnd = Lighting.FogEnd, FogColor = Lighting.FogColor}
local atm = Lighting:FindFirstChildOfClass("Atmosphere")
local originalAtm = atm and {Density = atm.Density, Offset = atm.Offset, Color = atm.Color, Decay = atm.Decay} or {}
local originalSky = Lighting:FindFirstChildOfClass("Sky") and Lighting:FindFirstChildOfClass("Sky"):Clone()

local rainPart, rainConnection = nil, nil
local musicSound = nil
local currentPreset = nil

-- === FUNGSI TAMBAHAN (SKYBOX CUSTOM) ===
local function applySkybox(ids, stars)
    local old = Lighting:FindFirstChildOfClass("Sky")
    if old then old:Destroy() end
    
    local sky = Instance.new("Sky")
    sky.SkyboxBk = "rbxassetid://"..ids[1]
    sky.SkyboxDn = "rbxassetid://"..ids[2]
    sky.SkyboxFt = "rbxassetid://"..ids[3]
    sky.SkyboxLf = "rbxassetid://"..ids[4]
    sky.SkyboxRt = "rbxassetid://"..ids[5]
    sky.SkyboxUp = "rbxassetid://"..ids[6]
    sky.StarCount = stars or 0
    sky.Parent = Lighting
    return sky
end

-- === FUNGSI LOGIK ===
local function createRain()
    if rainPart then rainPart:Destroy() end
    if rainConnection then rainConnection:Disconnect() end
    rainPart = Instance.new("Part") rainPart.Size = Vector3.new(400,0.1,400) rainPart.Transparency = 1 rainPart.Anchored = true rainPart.CanCollide = false rainPart.Parent = workspace
    local emitter = Instance.new("ParticleEmitter", rainPart)
    emitter.Texture = "rbxassetid://241837872" emitter.Rate = 1500 emitter.Lifetime = NumberRange.new(0.8,1.5) emitter.Speed = NumberRange.new(70,110)
    emitter.SpreadAngle = Vector2.new(5,5) emitter.EmissionDirection = Enum.NormalId.Bottom emitter.Shape = Enum.ParticleEmitterShape.Box
    emitter.Color = ColorSequence.new(Color3.fromRGB(180,200,255)) emitter.Size = NumberSequence.new(0.15,0.08) emitter.Transparency = NumberSequence.new(0,0.6)
    rainConnection = RunService.Heartbeat:Connect(function()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            rainPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0,80,0)
        end
    end)
end

local function destroyRain()
    if rainConnection then rainConnection:Disconnect() rainConnection = nil end
    if rainPart then rainPart:Destroy() rainPart = nil end
end

local function createDefaultSky(stars)
    -- Jika preset memiliki ID custom, jangan gunakan default sky
    if currentPreset and currentPreset.customSkyIds then
        applySkybox(currentPreset.customSkyIds, stars)
        return
    end

    local old = Lighting:FindFirstChildOfClass("Sky") if old then old:Destroy() end
    local sky = Instance.new("Sky")
    sky.SkyboxBk = "rbxassetid://600830446" sky.SkyboxDn = "rbxassetid://600831635" sky.SkyboxFt = "rbxassetid://600832643"
    sky.SkyboxLf = "rbxassetid://600832931" sky.SkyboxRt = "rbxassetid://600833183" sky.SkyboxUp = "rbxassetid://600833862"
    sky.StarCount = stars or 0 sky.Parent = Lighting
end

local function forceApply()
    if not currentPreset then return end
    createDefaultSky(currentPreset.stars or 0)
    Lighting.ClockTime = currentPreset.clock or 14
    Lighting.Brightness = currentPreset.brightness or 1
    Lighting.Ambient = currentPreset.ambient or Color3.fromRGB(170,170,170)
    Lighting.OutdoorAmbient = currentPreset.outdoor or Color3.fromRGB(170,170,170)
    Lighting.FogEnd = currentPreset.fogEnd or 100000
    Lighting.FogColor = currentPreset.fogColor or Color3.fromRGB(200,200,200)
    if atm then
        atm.Density = currentPreset.density or 0.25
        atm.Offset = currentPreset.offset or 0.25
        atm.Color = currentPreset.atmColor or Color3.new(1,1,1)
        atm.Decay = currentPreset.decay or Color3.fromRGB(200,200,200)
    end
    if currentPreset.rain then createRain() else destroyRain() end
end

local reapplyLoop = RunService.Heartbeat:Connect(function() if currentPreset then forceApply() end end)

local function playMusic(id)
    if musicSound then musicSound:Stop() end
    if not musicSound then
        musicSound = Instance.new("Sound", workspace)
        musicSound.Looped = true
        musicSound.Volume = 0.25
    end
    musicSound.SoundId = "rbxassetid://" .. id
    musicSound:Play()
end

local function globalReset()
    currentPreset = nil
    destroyRain()
    if musicSound then musicSound:Stop() end
    Lighting.ClockTime = original.ClockTime
    Lighting.Brightness = original.Brightness
    Lighting.Ambient = original.Ambient
    Lighting.OutdoorAmbient = original.OutdoorAmbient
    Lighting.FogEnd = original.FogEnd
    Lighting.FogColor = original.FogColor
    if atm then for k,v in pairs(originalAtm) do atm[k] = v end end
    if originalSky then 
        local old = Lighting:FindFirstChildOfClass("Sky") if old then old:Destroy() end
        local ns = originalSky:Clone() 
        ns.Parent = Lighting 
    end
end

