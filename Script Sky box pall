-- Drag Logic
local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = mainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input) dragging = false end)

-- Minimize Event
minBtn.MouseButton1Click:Connect(function()
    local isMin = (mainFrame.Size.Y.Offset < 100)
    mainFrame:TweenSize(isMin and UDim2.new(0, 220, 0, 340) or UDim2.new(0, 220, 0, 35), "Out", "Quad", 0.3, true)
    scroll.Visible = isMin
    minBtn.Text = isMin and "-" or "+"
end)

-- Close Event (RESET + DESTROY)
closeBtn.MouseButton1Click:Connect(function()
    globalReset()
    if reapplyLoop then reapplyLoop:Disconnect() end
    gui:Destroy()
end)

